{"dependencies":{"cors":"^2.8.5","dotenv":"^16.4.5","express":"^4.21.2","pg":"^8.13.0","zod":"^3.23.8"},"description":"VSR Inventory API — ledger-based convenience-store inventory for Verifone Commander stores.","devDependencies":{"@types/cors":"^2.8.17","@types/express":"^4.17.21","@types/node":"^22.7.0","@types/pg":"^8.11.10","tsx":"^4.19.1","typescript":"^5.6.2","vitest":"^2.1.5"},"engines":{"node":">=20"},"main":"dist/index.js","name":"vsr-inventory-api","private":true,"scripts":{"build":"tsc -p tsconfig.json","db:migrate":"psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f src/db/schema.sql","dev":"tsx watch src/index.ts","seed":"tsx src/seed.ts","start":"node dist/index.js","test":"vitest run","test:watch":"vitest","typecheck":"tsc --noEmit"},"version":"0.1.0"}