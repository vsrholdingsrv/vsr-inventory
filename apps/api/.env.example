# VSR Inventory API — copy to .env and fill in. Never commit a real .env.
PORT=3000
DATABASE_URL=postgres://vsr:vsr@localhost:5432/vsr_inventory

# commander | simulated (default). "commander" is reserved for the real
# CGI/NAXML connector, which swaps in only after Verifone Horizon approval.
COMMANDER_MODE=simulated

# sample | stub. "sample" returns the built-in Core-Mark sample invoice;
# "stub" throws until a real OCR provider is wired in. Never auto-posts.
OCR_PROVIDER=sample
