# Copy to .env and fill in real values. Never commit a filled-in .env.
# Docker Compose reads this file too (POSTGRES_*), so keep the DB values
# in sync with the DATABASE_URL the API uses.

# --- API ---
# Postgres connection string used by apps/api.
# Local Docker:  postgres://vsr:vsr@localhost:5432/vsr_inventory
# Render:        set to the Render Postgres "Internal Database URL".
DATABASE_URL=postgres://vsr:vsr@localhost:5432/vsr_inventory
PORT=4000

# --- Compose Postgres ---
POSTGRES_USER=vsr
POSTGRES_PASSWORD=vsr
POSTGRES_DB=vsr_inventory

# --- Web ---
# Public base URL of the API, baked into the web build at build time.
VITE_API_URL=http://localhost:4000
# Base URL of the web app (used by the API for CORS / links).
API_URL=http://localhost:5173

# --- Invoice OCR ---
# Pluggable OCR provider for invoice-scan. "stub" (default) returns no text
# and forces manual line entry; swap to a real provider (e.g. "tesseract",
# "aws-textract") once one is wired in — the interface lives in the API app
# and the draft is still human-confirmed either way.
OCR_PROVIDER=sample  # sample = demo Core-Mark invoice; stub = refuse to guess until a real OCR engine is wired in
