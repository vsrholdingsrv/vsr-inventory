{
  "description": "VSR Inventory — ledger-based inventory service for convenience stores, with live Verifone Commander POS integration.",
  "devDependencies": {
    "concurrently": "^9.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "license": "MIT",
  "name": "vsr-inventory",
  "private": true,
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "concurrently \"npm run dev --workspace=apps/api\" \"npm run dev --workspace=apps/web\"",
    "seed": "npm run seed --workspace=apps/api",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "version": "0.1.2",
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/shared"
  ]
}
